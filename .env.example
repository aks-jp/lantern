# --- Deployment variant -------------------------------------------------
# Same host as SearXNG (default): join its Docker network.
COMPOSE_FILE=compose.yml:compose.searxng.yml
SEARXNG_NETWORK=searxng_default
SEARXNG_URL=http://searxng:8080

# Remote SearXNG behind a reverse proxy with an API key:
# COMPOSE_FILE=compose.yml:compose.remote.yml
# SEARXNG_URL=https://search.example.com
# SEARXNG_API_KEY_HEADER=X-API-Key

# --- Lantern ------------------------------------------------------------
LANTERN_PORT=8090
# SEARXNG_TIMEOUT=10s
DEFAULT_LANGUAGE=de-DE
# DEFAULT_SAFESEARCH=1
# MAX_RESULTS=10
# SNIPPET_MAX_CHARS=300
# ALLOWED_CATEGORIES=general,news,science,it
# LOG_LEVEL=info
# LOG_FORMAT=json
